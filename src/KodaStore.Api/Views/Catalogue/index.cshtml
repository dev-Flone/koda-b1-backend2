@using System.Globalization
@model IReadOnlyList<KodaStore.Api.DTOs.ProductResponse>

@{
    Layout = null;
    ViewData["Title"] = "Catalogue Page";
    var rupiah = CultureInfo.GetCultureInfo("id-ID");
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData</title>
    <link rel="stylesheet" href="~/styles/Catalogue.css">
</head>

<body>
    <div class="table-container">
        <button>+ Add Product</button>
        <table>
            <thead>
                <tr>
                    <th>Product Code</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Stock</th>
                    <th>Price</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" style="margin: auto;">There is no Product yet.</td>
                    </tr>
                }
                else
                {
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.ProductCode</td>
                            <td>@p.Name</td>
                            <td>@p.Category</td>
                            <td>@p.Stock</td>
                            <td>@p.Price.ToString("C0", rupiah)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</body>

</html>